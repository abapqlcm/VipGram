+    // ── VipMod: Custom Font picker ───────────────────────────────
+    private void openFontPicker() {
+        try {
+            Intent intent = new Intent(Intent.ACTION_GET_CONTENT);
+            intent.setType("*/*");
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            boolean fa = LocaleController.getInstance().getCurrentLocale().getLanguage().equals("fa");
+            startActivityForResult(Intent.createChooser(intent, fa ? "انتخاب فایل فونت (ttf/otf)" : "Select font file (ttf/otf)"), 9701);
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode == 9701) {
+            boolean fa = LocaleController.getInstance().getCurrentLocale().getLanguage().equals("fa");
+            if (resultCode != Activity.RESULT_OK || data == null || data.getData() == null) {
+                return;
+            }
+            try {
+                Uri uri = data.getData();
+                String name = null;
+                try {
+                    Cursor c = ApplicationLoader.applicationContext.getContentResolver().query(uri, null, null, null, null);
+                    if (c != null) {
+                        int idx = c.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME);
+                        if (idx >= 0 && c.moveToFirst()) {
+                            name = c.getString(idx);
+                        }
+                        c.close();
+                    }
+                } catch (Throwable ignore) {}
+                if (name == null) {
+                    name = uri.getLastPathSegment();
+                }
+                String lower = name == null ? "" : name.toLowerCase();
+                if (!lower.endsWith(".ttf") && !lower.endsWith(".otf")) {
+                    if (getParentActivity() != null) {
+                        Toast.makeText(getParentActivity(), fa ? "فقط فایل ttf یا otf مجاز است" : "Only .ttf or .otf files are supported", Toast.LENGTH_SHORT).show();
+                    }
+                    return;
+                }
+                // copy the picked font into app storage so it survives across restarts
+                File dir = new File(ApplicationLoader.getFilesDirFixed(), "vipfonts");
+                dir.mkdirs();
+                File dst = new File(dir, "custom_" + System.currentTimeMillis() + (lower.endsWith(".otf") ? ".otf" : ".ttf"));
+                InputStream in = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri);
+                FileOutputStream out = new FileOutputStream(dst);
+                byte[] buf = new byte[8192];
+                int r;
+                while ((r = in.read(buf)) > 0) {
+                    out.write(buf, 0, r);
+                }
+                out.close();
+                in.close();
+                // sanity check: can Android actually parse this font?
+                try {
+                    android.graphics.Typeface test = android.graphics.Typeface.createFromFile(dst);
+                    if (test == null) {
+                        throw new Exception("invalid font");
+                    }
+                } catch (Throwable badFont) {
+                    dst.delete();
+                    if (getParentActivity() != null) {
+                        Toast.makeText(getParentActivity(), fa ? "این فایل فونت معتبر نیست" : "This font file is not valid", Toast.LENGTH_SHORT).show();
+                    }
+                    return;
+                }
+                // remove any previously stored font files to keep storage clean
+                try {
+                    File[] old = dir.listFiles();
+                    if (old != null) {
+                        for (File f : old) {
+                            if (!f.equals(dst)) {
+                                f.delete();
+                            }
+                        }
+                    }
+                } catch (Throwable ignore) {}
+                AndroidUtilities.setCustomFont(dst.getAbsolutePath());
+                if (getParentActivity() != null) {
+                    Toast.makeText(getParentActivity(), fa ? "فونت اعمال شد" : "Font applied", Toast.LENGTH_SHORT).show();
+                }
+                AndroidUtilities.runOnUIThread(() -> {
+                    if (getParentActivity() != null) {
+                        getParentActivity().recreate();
+                    }
+                }, 400);
+            } catch (Exception e) {
+                FileLog.e(e);
+                if (getParentActivity() != null) {
+                    Toast.makeText(getParentActivity(), fa ? "خطا در اعمال فونت" : "Failed to apply font", Toast.LENGTH_SHORT).show();
+                }
+            }
+        }
+    }
