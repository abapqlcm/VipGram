+            BulletinFactory.of(this).createErrorBulletin(LocaleController.getInstance().getCurrentLocale().getLanguage().equals("fa") ? LocaleController.getString(R.string.VipFontErrorFa) : LocaleController.getString(R.string.VipFontError), themeDelegate).show();
+        }
+    }
+
+    // VipMod v2.4: save all media in current chat with one tap
+    private void saveAllMedia() {
+        if (getParentActivity() == null || messages == null || messages.isEmpty()) {
+            return;
+        }
+        ArrayList<MessageObject> mediaToSave = new ArrayList<>();
+        boolean isMusic = false;
+        for (int i = 0; i < messages.size(); i++) {
+            MessageObject msg = messages.get(i);
+            if (msg == null || msg.messageOwner == null) continue;
+            if (msg.isVideo() || msg.isPhoto() || msg.isMusic() || msg.getDocument() != null || msg.isVoice() || msg.isRoundVideo()) {
+                mediaToSave.add(msg);
+                if (MessageObject.isMusicDocument(msg.getDocument())) isMusic = true;
+            }
+        }
+        if (mediaToSave.isEmpty()) {
+            String noMedia = LocaleController.getInstance().getCurrentLocale().getLanguage().equals("fa") ? LocaleController.getString(R.string.NoMediaFoundFa) : LocaleController.getString(R.string.NoMediaFound);
+            BulletinFactory.of(this).createErrorBulletin(noMedia, themeDelegate).show();
+            return;
+        }
+        final boolean isMusicFinal = isMusic;
+        MediaController.saveFilesFromMessages(getParentActivity(), getAccountInstance(), mediaToSave, (count) -> {
+            if (getParentActivity() == null) return;
+            if (count > 0) {
+                BulletinFactory.of(ChatActivity.this).createDownloadBulletin(isMusicFinal ? BulletinFactory.FileType.AUDIOS : BulletinFactory.FileType.UNKNOWNS, count, themeDelegate).show();
+            }
+        });
+    }
+
+    // VipMod v2.4: export chat history to ZIP (HTML + JSON + media) like Telegram desktop export
+    private void exportChatHistory() {
+        if (getParentActivity() == null || messages == null || messages.isEmpty()) {
+            return;
+        }
+        try {
+            File baseDir = new File(Environment.getExternalStorageDirectory(), "VipGram_Exports");
+            if (!baseDir.exists()) baseDir.mkdirs();
+            long stamp = System.currentTimeMillis();
+            String folderName = "chat_" + dialog_id + "_" + stamp;
+            File workDir = new File(baseDir, folderName);
+            File mediaDir = new File(workDir, "media");
+            mediaDir.mkdirs();
+
+            // ---- build peer name / avatar ----
+            String peerName = "Chat";
+            String peerUser = "";
+            String peerType = DialogObject.isUserDialog(dialog_id) ? "Private" : (ChatObject.isChannel(-dialog_id, currentAccount) ? "Channel" : "Group");
+            if (currentUser != null) {
+                peerName = UserObject.getUserName(currentUser);
+                peerUser = (currentUser.username != null && !currentUser.username.isEmpty()) ? "@" + currentUser.username : "";
+            } else if (currentChat != null) {
+                peerName = currentChat.title;
+            }
+            // copy avatar if available
+            String avatarRel = "";
+            TLRPC.FileLocation avatarLoc = null;
+            if (currentUser != null && currentUser.photo != null && currentUser.photo.photo_small != null) {
+                avatarLoc = currentUser.photo.photo_small;
+            } else if (currentChat != null && currentChat.photo != null && currentChat.photo.photo_small != null) {
+                avatarLoc = currentChat.photo.photo_small;
+            }
+            if (avatarLoc != null) {
+                try {
+                    File av = FileLoader.getInstance(currentAccount).getPathToAttach(avatarLoc, true);
+                    if (av != null && av.exists()) {
+                        File avOut = new File(mediaDir, "avatar.jpg");
+                        copyFile(av, avOut);
+                        avatarRel = "media/avatar.jpg";
+                    }
+                } catch (Exception ignore) {}
+            }
+
+            // ---- gather media + build JSON ----
+            StringBuilder json = new StringBuilder();
+            json.append("{\n  \"peer\": \"").append(escapeJson(peerName)).append("\",\n  \"type\": \"").append(peerType).append("\",\n  \"messages\": [\n");
+            StringBuilder html = new StringBuilder();
+            html.append("<!DOCTYPE html><html lang=\"fa\"><head><meta charset=\"utf-8\"><title>").append(escapeHtml(peerName)).append("</title>");
+            html.append("<style>");
+            html.append("body{background:#f0f2f5;font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;margin:0;padding:0;}");
+            html.append(".topbar{background:#5288c1;color:#fff;padding:12px 16px;display:flex;align-items:center;position:sticky;top:0;}");
+            html.append(".topbar img{width:42px;height:42px;border-radius:50%;margin-left:10px;object-fit:cover;}");
+            html.append(".topbar .name{font-weight:600;font-size:16px;} .topbar .sub{font-size:12px;opacity:.85;}");
+            html.append(".wrap{max-width:760px;margin:0 auto;padding:14px;}");
+            html.append(".row{display:flex;margin:6px 0;} .row.out{justify-content:flex-end;}");
+            html.append(".bub{background:#fff;padding:8px 12px;border-radius:12px;max-width:75%;box-shadow:0 1px 1px rgba(0,0,0,.1);}");
+            html.append(".row.out .bub{background:#e3f1fd;} .meta{font-size:11px;color:#999;margin-top:3px;}");
+            html.append(".bub img{max-width:260px;border-radius:8px;display:block;} .bub audio,.bub video{max-width:260px;display:block;}");
+            html.append("</style></head><body>");
+            html.append("<div class='topbar'>");
+            if (!avatarRel.isEmpty()) html.append("<img src='").append(avatarRel).append("'>");
+            html.append("<div><div class='name'>").append(escapeHtml(peerName)).append("</div>");
+            html.append("<div class='sub'>").append(escapeHtml(peerUser.isEmpty() ? peerType : peerUser + "  •  " + peerType)).append("</div></div></div>");
+            html.append("<div class='wrap'>");
+
+            int idx = 0, total = messages.size();
+            for (int i = 0; i < total; i++) {
+                MessageObject msg = messages.get(i);
+                if (msg == null || msg.messageOwner == null) continue;
+                boolean isOut = msg.isOut();
+                String text = msg.messageText != null ? msg.messageText.toString() : "";
+                long date = msg.messageOwner.date != 0 ? msg.messageOwner.date * 1000L : stamp;
+                String time = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", LocaleController.getInstance().getCurrentLocale()).format(new java.util.Date(date));
+
+                // media path
+                String mediaRel = "";
+                if (msg.isPhoto() || msg.isVideo() || msg.isMusic() || msg.isVoice() || msg.isRoundVideo() || msg.getDocument() != null) {
+                    try {
+                        File src = FileLoader.getInstance(currentAccount).getPathToMessage(msg.messageOwner);
+                        if (src != null && src.exists()) {
+                            String ext = "";
+                            String fn = MessageObject.getFileName(msg.messageOwner);
+                            int dot = fn.lastIndexOf('.');
+                            if (dot >= 0) ext = fn.substring(dot);
+                            File dst = new File(mediaDir, "m" + idx + ext);
+                            copyFile(src, dst);
+                            mediaRel = "media/m" + idx + ext;
+                        }
+                    } catch (Exception ignore) {}
+                }
+
+                // JSON line
+                json.append("    {\"date\":").append(date).append(",\"out\":").append(isOut).append(",\"text\":\"").append(escapeJson(text)).append("\"");
+                if (!mediaRel.isEmpty()) json.append(",\"media\":\"").append(mediaRel).append("\"");
+                json.append("}");
+                if (i < total - 1) json.append(",");
+                json.append("\n");
+
+                // HTML bubble
+                html.append("<div class='row ").append(isOut ? "out" : "in").append("'><div class='bub'>");
+                if (!mediaRel.isEmpty()) {
+                    if (msg.isVideo() || msg.isRoundVideo()) {
+                        html.append("<video controls src='").append(mediaRel).append("'></video>");
+                    } else if (msg.isVoice() || msg.isMusic()) {
+                        html.append("<audio controls src='").append(mediaRel).append("'></audio>");
+                    } else {
+                        html.append("<img src='").append(mediaRel).append("'>");
+                    }
+                }
+                if (!text.isEmpty()) html.append("<div>").append(escapeHtml(text)).append("</div>");
+                html.append("<div class='meta'>").append(time).append("</div>");
+                html.append("</div></div>");
+                idx++;
+            }
+            html.append("</div></body></html>");
+            json.append("  ]\n}");
+
+            // ---- write html + json into work dir ----
+            FileWriter hw = new FileWriter(new File(workDir, "chat.html"));
+            hw.write(html.toString());
+            hw.close();
+            FileWriter jw = new FileWriter(new File(workDir, "chat.json"));
+            jw.write(json.toString());
+            jw.close();
+
+            // ---- zip the folder ----
+            File zipFile = new File(baseDir, folderName + ".zip");
+            zipFolder(workDir, zipFile);
+            // cleanup unzipped work dir
+            deleteRecursively(workDir);
+
+            String doneMsg = LocaleController.getInstance().getCurrentLocale().getLanguage().equals("fa") ? LocaleController.getString(R.string.VipExportDoneFa) : LocaleController.getString(R.string.VipExportDone);
+            BulletinFactory.of(this).createSimpleBulletin(doneMsg, zipFile.getAbsolutePath()).show();
+        } catch (Exception e) {
+            FileLog.e("VipGram export", e);
+            String errMsg = LocaleController.getInstance().getCurrentLocale().getLanguage().equals("fa") ? LocaleController.getString(R.string.VipExportErrorFa) : LocaleController.getString(R.string.VipExportError);
+            BulletinFactory.of(this).createErrorBulletin(errMsg, themeDelegate).show();
+        }
+    }
+
+    // VipMod v2.4: helper to zip a folder
+    private static void zipFolder(File srcDir, File zipFile) throws Exception {
+        try (ZipOutputStream zos = new ZipOutputStream(new BufferedOutputStream(new FileOutputStream(zipFile)))) {
+            byte[] buf = new byte[8192];
+            java.io.File[] files = srcDir.listFiles();
+            if (files == null) return;
+            for (java.io.File f : files) {
+                if (f.isDirectory()) continue;
+                try (BufferedInputStream bis = new BufferedInputStream(new FileInputStream(f))) {
+                    zos.putNextEntry(new ZipEntry(f.getName()));
+                    int len;
+                    while ((len = bis.read(buf)) > 0) zos.write(buf, 0, len);
+                    zos.closeEntry();
+                }
+            }
+        }
+    }
+
+    // VipMod v2.4: helper to copy file
+    private static void copyFile(File src, File dst) throws Exception {
+        try (FileInputStream fis = new FileInputStream(src); FileOutputStream fos = new FileOutputStream(dst)) {
+            byte[] buf = new byte[8192];
+            int len;
+            while ((len = fis.read(buf)) > 0) fos.write(buf, 0, len);
+        }
+    }
+
+    // VipMod v2.4: helper to delete recursively
+    private static void deleteRecursively(File dir) {
+        if (dir == null || !dir.exists()) return;
+        java.io.File[] files = dir.listFiles();
+        if (files != null) for (java.io.File f : files) {
+            if (f.isDirectory()) deleteRecursively(f); else f.delete();
+        }
+        dir.delete();
+    }
+
+    // VipMod v2.4: escape helpers for html/json
+    private static String escapeHtml(String s) {
+        if (s == null) return "";
+        return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;");
+    }
+    private static String escapeJson(String s) {
+        if (s == null) return "";
+        return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "");
+    }
 }
